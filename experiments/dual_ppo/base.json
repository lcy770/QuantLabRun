{
  "architecture": "candidate_selection",
  "seed": 0,
  "device": "auto",
  "data_mode": "exploratory",
  "target_horizon": 20,
  "lookback": 100,
  "future_days": 20,
  "width": 32,
  "torch_threads": 2,
  "signal_cache_size": 64,
  "rollout_workers": 1,
  "record_rollouts": true,
  "grammar": {
    "fields": [
      "open",
      "close",
      "high",
      "low",
      "volume",
      "amount",
      "TurnoverRate"
    ],
    "operators": [
      "abs",
      "sign",
      "reverse",
      "log",
      "add",
      "sub",
      "mul",
      "div",
      "max",
      "min",
      "ts_mean",
      "ts_std",
      "ts_var",
      "delay",
      "delta",
      "ts_corr",
      "ts_covariance",
      "ts_rank"
    ],
    "windows": [
      1,
      5,
      10,
      20,
      40
    ],
    "constants": [
      -1.0,
      -0.5,
      0.0,
      0.5,
      1.0,
      2.0
    ],
    "max_nodes": 15,
    "max_depth": 8,
    "max_lookback": 100,
    "strict_types": true
  },
  "initial_seeds": 16,
  "initial_library": "assets/library.jsonl",
  "corpus": {
    "count": 144,
    "noise_steps": 4,
    "seed": 0
  },
  "pretrain": {
    "epochs": 2,
    "learning_rate": 0.001,
    "batch_size": 8
  },
  "reward": {
    "thresholds": [
      0.02,
      0.01,
      0.1,
      0.8
    ],
    "kappa": 0.05,
    "alpha": 50.0,
    "beta": 25.0,
    "gamma": 0.5,
    "eta": 0.0,
    "member_segment": "feedback",
    "block_days": 10,
    "reference_seconds": null,
    "calibration_samples": 8
  },
  "lower": {
    "iterations": 128,
    "batch_formulas": 16,
    "shortlist_size": 32,
    "diffusion_steps": 4,
    "perturbation_steps": 4,
    "learning_rate": 0.0003,
    "gae_lambda": 1.0,
    "ppo": {
      "epochs": 4,
      "batch_size": 16,
      "clip": 0.2,
      "entropy_weight": 0.01,
      "value_weight": 0.5
    }
  },
  "upper": {
    "iterations": 16,
    "joint_iterations": 0,
    "episodes_per_batch": 4,
    "pool_attempts": 128,
    "max_members": 10,
    "learning_rate": 0.0003,
    "gae_lambda": 1.0,
    "ppo": {
      "epochs": 4,
      "batch_size": 16,
      "clip": 0.2,
      "entropy_weight": 0.01,
      "value_weight": 0.5
    }
  },
  "search": {
    "candidate_capacity": 128,
    "max_attempts": 10000,
    "seconds": 1800.0,
    "budget_mode": "wall_seconds"
  },
  "evaluation": {
    "seeds": [
      0
    ],
    "methods": [
      "upper_ppo"
    ],
    "deterministic": true
  }
